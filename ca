/** Quick smoke test: app loads, Casio visible, gaze cursor overlay present */
const { chromium } = require('playwright');

const TARGET_URL = 'http://localhost:5174';

(async () => {
  const browser = await chromium.launch({ headless: false, slowMo: 100 });
  const context = await browser.newContext({ viewport: { width: 1280, height: 800 } });
  const page = await context.newPage();

  const errors = [];
  page.on('pageerror', err => { errors.push(err.message); });
  page.on('console', msg => {
    if (msg.type() === 'error') errors.push(msg.text());
  });

  await page.goto(TARGET_URL, { waitUntil: 'networkidle', timeout: 15000 });
  console.log('✅ Page loaded');

  // Check Casio calculator is present
  const calc = await page.$('#calculator');
  console.log(calc ? '✅ #calculator found' : '❌ #calculator MISSING');

  // Check LCD screen
  const lcd = await page.$('#lcd');
  console.log(lcd ? '✅ #lcd found' : '❌ #lcd MISSING');

  // Check gaze overlay + cursor
  const overlay = await page.$('#gaze-overlay');
  console.log(overlay ? '✅ #gaze-overlay found' : '❌ #gaze-overlay MISSING');
  const cursor = await page.$('#gaze-cursor');
  console.log(cursor ? '✅ #gaze-cursor found' : '❌ #gaze-cursor MISSING');

  // Check Casio data-key buttons exist (count them)
  const btns = await page.$$('#casio-app [data-key]');
  console.log(`✅ ${btns.length} [data-key] buttons found (expect ~45+)`);

  // Check output
  const output = await page.$('#screen-output');
  console.log(output ? '✅ #screen-output found' : '❌ #screen-output MISSING');

  // Click a Casio button via mouse to test hitTest + handleKey
  const btn7 = await page.$('[data-key="7"]');
  if (btn7) {
    const box = await btn7.boundingBox();
    await page.mouse.click(box.x + box.width/2, box.y + box.height/2);
    console.log('✅ Clicked [data-key="7"]');
    await page.waitForTimeout(300);
  }

  // Check if screen shows "7"
  const inputContent = await page.$eval('#screen-input', el => el.textContent);
  console.log(`📟 Screen input: "${inputContent}"`);

  if (errors.length > 0) {
    console.log('❌ Errors:', errors.join(' | '));
  } else {
    console.log('✅ NO JS errors');
  }

  await page.screenshot({ path: '/tmp/casio-load.png', fullPage: false });
  console.log('📸 Screenshot -> /tmp/casio-load.png');

  await browser.close();
  console.log('Done.');
})();
