# Firebase Web App config — copy file này thành .env rồi điền giá trị thật
# Lấy tại: Firebase Console → Project Settings (⚙️) → Your apps → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
# Database ID của Firestore (tên database bạn đặt trong Console; để trống nếu dùng database mặc định)
VITE_FIREBASE_DATABASE_ID=